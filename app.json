{
  "expo": {
    "name": "現在地の標高計",
    "slug": "project_202610",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "project202610",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.airgroove0724.elevationmeter",
      "icon": "./assets/expo.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "現在地の標高（海抜）を計算・表示するために位置情報を使用します。"
      }
    },
    "android": {
      "package": "com.airgroove0724.elevationmeter",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D1D36",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1D36",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地の標高（海抜）を計算・表示するために位置情報を使用します。",
          "locationAlwaysAndWhenInUsePermission": "現在地の標高（海抜）を計算・表示するために位置情報を使用します。",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "371e918d-d40d-4459-991c-22ee616b2bfd"
      }
    },
    "owner": "airgroove0724"
  }
}
